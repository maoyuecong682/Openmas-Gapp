{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmas-gapp.org/schemas/mas-spec.schema.json",
  "title": "OpenMAS-Gapp MAS Specification",
  "type": "object",
  "required": ["package_id", "baseline", "nodes", "edges", "selected_capabilities"],
  "properties": {
    "package_id": {"type": "string"},
    "baseline": {"type": "string"},
    "nodes": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "edges": {"type": "array", "items": {"type": "object"}},
    "selected_capabilities": {"type": "array", "items": {"type": "string"}},
    "metadata": {"type": "object"}
  }
}

